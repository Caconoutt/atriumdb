# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored - keep the real dataset path out of git.

# Absolute path ON THE HOST (the remote server) to the AtriumDB dataset
# directory - the one that contains meta/index.db and tsc/.
# It is mounted read-only inside the container at /data/atriumdb.
DATASET_LOCATION=/replace/with/path/to/dataset

# UID/GID the container runs as, so files written to ./out stay owned by you.
# On the server:  id -u   and   id -g
LOCAL_UID=1000
LOCAL_GID=1000
